{
  "name": "orbit-chat-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-image-storage.mjs && vue-tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "selecto": "1.26.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.10",
    "terser": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.14"
  }
}
